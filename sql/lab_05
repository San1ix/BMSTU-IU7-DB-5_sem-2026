-- 1. Таблица -> JSON
COPY (
	SELECT jsonb_agg(row_to_json(menu_items))
	FROM menu_items
) TO '/tmp/exported_menu.json';

-- 2. 

CREATE TABLE menu_items_imp (
	menu_item_id INT PRIMARY KEY,
    category VARCHAR(50),
    name VARCHAR(100),
    unit VARCHAR(20),
    portion_size INT,
    price NUMERIC(10, 2),
    is_available BOOLEAN
);

CREATE TEMP TABLE menu_items_json (
	doc JSONB
);

COPY menu_items_json (doc)
FROM '/tmp/exported_menu.json';

INSERT INTO menu_items_imp (menu_item_id, category, name, unit, portion_size, price, is_available)
SELECT
	(item ->> 'menu_item_id')::INT
	, item ->> 'category'
	, item ->> 'name'
	, item ->> 'unit'
	, (item ->> 'portion_size')::INT
	, (item ->> 'price')::NUMERIC
	, (item ->> 'is_available')::BOOLEAN
FROM menu_items_json, jsonb_array_elements(doc) AS item;

DROP TABLE IF EXISTS menu_items_imp;

-- 3. 

ALTER TABLE menu_items 
ADD COLUMN nutrition_facts JSONB;
ALTER TABLE menu_items 
DROP COLUMN nutrition_facts;

UPDATE menu_items 
SET nutrition_facts = '{"calories": 430, "macros": {"p": 5, "f": 27, "c": 37}, "vegan": false}'
WHERE menu_item_id = 2;

-- 4. 

SELECT nutrition_facts -> 'macros' AS "БЖУ"
	, nutrition_facts ->> 'calories' AS "Калорийность"
	, nutrition_facts ? 'vegan' AS "Есть ли ключ vegan"
FROM menu_items
WHERE menu_item_id  = 2;

UPDATE menu_items
SET nutrition_facts = jsonb_set(nutrition_facts, '{calories}', '450')
WHERE menu_item_id = 2;

SELECT key AS "Макронутриент"
	, value AS "Гр"
FROM menu_items, jsonb_each(nutrition_facts->'macros')
WHERE menu_item_id = 2;




